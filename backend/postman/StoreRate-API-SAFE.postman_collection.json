            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A Name At Least Twenty Characters\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"address\": \"123 Test Street\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          }
