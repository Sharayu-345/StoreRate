    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "List Users (with filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/users?name=&email=&address=&role=&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "name", "value": "" },
                { "key": "email", "value": "" },
                { "key": "address", "value": "" },
                { "key": "role", "value": "" },
                { "key": "sortBy", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Add User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A Name At Least Twenty Characters\",\n  \"email\": \"newadmin@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"address\": \"123 Test Street\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "List Stores (admin view)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/stores?name=&email=&address=&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stores"],
              "query": [
                { "key": "name", "value": "" },
                { "key": "email", "value": "" },
                { "key": "address", "value": "" },
                { "key": "sortBy", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Add Store",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample New Store\",\n  \"email\": \"samplenew@example.com\",\n  \"address\": \"456 Market Road, Mumbai\",\n  \"ownerId\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/stores", "host": ["{{baseUrl}}"], "path": ["admin", "stores"] }
          }
        }
      ]
    },
    {
      "name": "Stores & Ratings",
      "item": [
        {
          "name": "List Stores (user view, with search)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/stores?name=&address=",
              "host": ["{{baseUrl}}"],
              "path": ["stores"],
              "query": [
                { "key": "name", "value": "" },
                { "key": "address", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Submit / Update Rating (Zebra Bakery, id 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/2/ratings", "host": ["{{baseUrl}}"], "path": ["stores", "2", "ratings"] }
          }
        }
      ]
    },
    {
